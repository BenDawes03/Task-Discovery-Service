# Copy to Simulation/orchestrate.env and edit.

# SSH user configuration
#
# Simplest: one user for all hosts
SSH_USER_DEFAULT=user
# Backwards compatible (older envs used SSH_USER). If both are set, SSH_USER_DEFAULT wins.
SSH_USER=

# Optional: per-host users (space-separated list of host,user)
# Example:
#   SSH_USERS="192.168.100.10,CentralSystem 192.168.100.11,PaymentService"
SSH_USERS=

# Repo dir on each VM
REMOTE_REPO_DIR=~/bxd280

# If 1, run a repo sync (tar over ssh) to all VMs before `up`.
# You can also run it manually: ./Simulation/orchestrate.sh sync
SYNC_BEFORE_UP=0

# Extra exclude patterns (space-separated) for sync.
# Example: SYNC_EXCLUDES_EXTRA=".idea node_modules"
SYNC_EXCLUDES_EXTRA=

# Central TDS server host (runs cmd/server)
TDS_SERVER_HOST=192.168.100.13
TDS_SERVER_PORT=5000

# Centralized client_proxy listen on each VM
PROXY_LISTEN=127.0.0.1:5100

# CS (OY) service
CS_HOST=192.168.100.10
CS_LISTEN=:9101
CS_ADVERTISE=http://192.168.100.10:9101
CS_DB_DSN="postgres://CentralSystem:cs@localhost:5432/CentralSystem?sslmode=disable"

# PCTRBO service
PCTRBO_HOST=192.168.100.12
PCTRBO_LISTEN=:9102
PCTRBO_ADVERTISE=http://192.168.100.12:9102
PCTRBO_DB_DSN="postgres://PCTRService:password@localhost:5432/PCTRService?sslmode=disable"

# PA service
PA_HOST=192.168.100.11
PA_LISTEN=:9103
PA_ADVERTISE=http://192.168.100.11:9103
PA_DB_DSN="postgres://PaymentService:password@localhost:5432/PaymentService?sslmode=disable"
# Path on PA VM (you must provision this file; it is not committed in-repo)
PA_PRIVATE_KEY=./pctr_private.pem

# Path on Gate/Station VMs
PCTR_PUBLIC_KEY=./pctr_public.pem

# Stations and gates are lists. Format:
#   STATIONS="<host>,<station-id>,<listen>,<advertise> ..."
#   GATES="<host>,<gate-id>,<station-id>,<listen> ..."

STATIONS="192.168.100.14,station-1,:9100,http://192.168.100.14:9100 192.168.100.15,station-2,:9100,http://192.168.100.15:9100"

GATES="192.168.100.14,gate-1,station-1,:9200 192.168.100.14,gate-2,station-1,:9201 192.168.100.15,gate-3,station-2,:9200 192.168.100.15,gate-4,station-2,:9201"
